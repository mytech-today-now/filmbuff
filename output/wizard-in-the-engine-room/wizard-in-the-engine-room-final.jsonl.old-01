{"number":"28a.1","sceneNumber":2,"heading":{"raw":"INT. USS ENTERPRISE - CONFERENCE ROOM - CONTINUOUS","intExt":"INT","location":"USS ENTERPRISE - CONFERENCE ROOM","timeOfDay":"CONTINUOUS"},"context":{"set":"INT. USS ENTERPRISE - CONFERENCE ROOM - CONTINUOUS","lighting":"natural ambient, balanced, neutral (5000K)","timeOfDay":"CONTINUOUS","atmosphere":"neutral","weather":null},"characters":[{"name":"FIRST OFFICER","position":"in scene","appearance":"","wardrobe":null,"physicalAppearance":null,"emotion":"another pause","action":null},{"name":"WIZARD HIGH","position":"in scene","appearance":"","wardrobe":null,"physicalAppearance":null,"emotion":null,"action":null}],"set":"INT. USS ENTERPRISE - CONFERENCE ROOM - CONTINUOUS","description":"The Captain sits at the head of the table. Clif and Heidi sit across from each other, looking guilty. The First Officer stands.. The continuous setting affects the lighting and mood","actions":"No specific actions in this shot","dialogue":"FIRST OFFICER\nanother pause\nThe needs of the many outweigh the needs of the few.  Or the two. \nCan Starfleet even afford to let you retire, Wizard High?  Faster-than-light travel is scientifically impossible.","blocking":"FIRST OFFICER: stands stands (center stage, upstage)","sfx":"No sound effects specified","techDetails":"Shot Type: establishing. Camera Movement: static. Framing: medium. Visual Style: Reality","metadata":{"shotType":"establishing","cameraMovement":"static","framing":"medium","visualStyle":"Reality","cinematicStyle":null,"technicalNotes":[]},"duration":{"seconds":12,"formatted":"0:12"},"characterCount":{"count":637,"limit":637,"percentage":100},"warnings":[]}
{"number":"28a.2","sceneNumber":2,"heading":{"raw":"INT. USS ENTERPRISE - CONFERENCE ROOM - CONTINUOUS","intExt":"INT","location":"USS ENTERPRISE - CONFERENCE ROOM","timeOfDay":"CONTINUOUS"},"context":{"set":"INT. USS ENTERPRISE - CONFERENCE ROOM - CONTINUOUS","lighting":"natural ambient, balanced, neutral (5000K)","timeOfDay":"CONTINUOUS","atmosphere":"neutral","weather":null},"characters":[{"name":"FIRST OFFICER","position":"in scene","appearance":"","wardrobe":null,"physicalAppearance":null,"emotion":null,"action":null}],"set":"INT. USS ENTERPRISE - CONFERENCE ROOM - CONTINUOUS","description":"The Captain sits at the head of the table. Clif and Heidi sit across from each other, looking guilty. The First Officer stands.. The continuous setting affects the lighting and mood","actions":"No specific actions in this shot","dialogue":"FIRST OFFICER\nWe've known this for 200 years.  Without wizards, we don't have warp drive.  We don't have transporters.  We don't have force fields.","blocking":"FIRST OFFICER: stands stands (center stage, upstage)","sfx":"No sound effects specified","techDetails":"Shot Type: medium. Camera Movement: static. Framing: medium. Visual Style: Reality","metadata":{"shotType":"medium","cameraMovement":"static","framing":"medium","visualStyle":"Reality","cinematicStyle":null,"technicalNotes":[]},"duration":{"seconds":9,"formatted":"0:09"},"characterCount":{"count":570,"limit":570,"percentage":100},"warnings":[]}
