{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://filmbuff.local/schemas/lifecycle-artifact.schema.json",
  "title": "FilmBuff Lifecycle Artifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "createdAt",
    "updatedAt",
    "application",
    "state",
    "paths",
    "history",
    "backups",
    "result"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "application": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "identifier", "packageVersion"],
      "properties": {
        "name": {
          "type": "string"
        },
        "identifier": {
          "type": "string"
        },
        "packageVersion": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+(?:[-+][0-9A-Za-z.-]+)?$"
        },
        "installedVersion": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+(?:[-+][0-9A-Za-z.-]+)?$"
        },
        "previousVersion": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+(?:[-+][0-9A-Za-z.-]+)?$"
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "platform": {
          "type": "string"
        },
        "arch": {
          "type": "string"
        },
        "nodeVersion": {
          "type": "string"
        },
        "runtime": {
          "type": "string"
        }
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "current",
        "detected",
        "installed",
        "rollbackAvailable",
        "diagnosticAvailable",
        "recoveryRequired"
      ],
      "properties": {
        "current": {
          "type": "string",
          "enum": [
            "not-installed",
            "installation-detected",
            "installation-in-progress",
            "installation-completed",
            "installation-partially-completed",
            "installation-failed",
            "upgrade-available",
            "upgrade-in-progress",
            "rollback-available",
            "rollback-in-progress",
            "uninstallation-pending-confirmation",
            "uninstallation-in-progress",
            "uninstallation-partially-completed",
            "uninstallation-completed",
            "diagnostic-analysis-in-progress",
            "repair-available",
            "repair-in-progress",
            "recovery-required"
          ]
        },
        "detected": {
          "type": "boolean"
        },
        "installed": {
          "type": "boolean"
        },
        "rollbackAvailable": {
          "type": "boolean"
        },
        "diagnosticAvailable": {
          "type": "boolean"
        },
        "recoveryRequired": {
          "type": "boolean"
        },
        "lastOperation": {
          "type": "string"
        },
        "lastStep": {
          "type": "string"
        },
        "failureReason": {
          "type": "string"
        }
      }
    },
    "paths": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projectRoot", "artifactDir", "backupDir", "diagnosticDir"],
      "properties": {
        "projectRoot": { "type": "string" },
        "augmentDir": { "type": "string" },
        "artifactDir": { "type": "string" },
        "artifactPath": { "type": "string" },
        "backupDir": { "type": "string" },
        "diagnosticDir": { "type": "string" },
        "promptArchiveDir": { "type": "string" },
        "promptArchivePath": { "type": "string" },
        "configPath": { "type": "string" },
        "commandHelpPath": { "type": "string" }
      }
    },
    "installation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["fresh", "reinstall", "upgrade", "restore", "uninstall"]
        },
        "source": {
          "type": "string",
          "enum": ["workspace", "artifact", "package-manager", "unknown"]
        },
        "startedAt": {
          "type": "string",
          "format": "date-time"
        },
        "completedAt": {
          "type": "string",
          "format": "date-time"
        },
        "installedVersion": {
          "type": "string"
        },
        "previousVersion": {
          "type": "string"
        },
        "progress": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "completedSteps": { "type": "array", "items": { "type": "string" } },
            "remainingSteps": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    },
    "upgrade": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "available": { "type": "boolean" },
        "previousVersion": { "type": "string" },
        "targetVersion": { "type": "string" },
        "rollbackAvailable": { "type": "boolean" }
      }
    },
    "promptArchive": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sourceDir": { "type": "string" },
        "archivePath": { "type": "string" },
        "checksum": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "entryCount": { "type": "integer", "minimum": 0 },
        "verified": { "type": "boolean" },
        "extractedAt": { "type": "string", "format": "date-time" }
      }
    },
    "checksums": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "packageJson": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "packageLock": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "extensionsConfig": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "commandHelp": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "promptArchive": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "credentials": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "status", "reference"],
            "properties": {
              "name": { "type": "string" },
              "status": {
                "type": "string",
                "enum": ["secure-reference", "missing", "expired", "revoked", "inaccessible", "reauthenticate"]
              },
              "reference": { "type": "string" },
              "managedBy": { "type": "string" },
              "requiresUserAction": { "type": "boolean" }
            }
          }
        }
      }
    },
    "diagnostics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "lastRunAt": { "type": "string", "format": "date-time" },
        "reportPath": { "type": "string" },
        "summary": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "critical": { "type": "integer", "minimum": 0 },
            "high": { "type": "integer", "minimum": 0 },
            "medium": { "type": "integer", "minimum": 0 },
            "low": { "type": "integer", "minimum": 0 },
            "warning": { "type": "integer", "minimum": 0 },
            "informational": { "type": "integer", "minimum": 0 }
          }
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "severity",
              "title",
              "explanation",
              "evidence",
              "blocked"
            ],
            "properties": {
              "id": { "type": "string" },
              "severity": {
                "type": "string",
                "enum": ["critical", "high", "medium", "low", "warning", "informational"]
              },
              "title": { "type": "string" },
              "explanation": { "type": "string" },
              "evidence": { "type": "array", "items": { "type": "string" } },
              "path": { "type": "string" },
              "blocked": { "type": "boolean" },
              "recommendedSolution": { "type": "string" },
              "risk": { "type": "string" },
              "reversible": { "type": "boolean" },
              "requiresPermission": { "type": "boolean" },
              "requiresConfirmation": { "type": "boolean" },
              "expectedResult": { "type": "string" },
              "actions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["id", "label", "safe"],
                  "properties": {
                    "id": { "type": "string" },
                    "label": { "type": "string" },
                    "safe": { "type": "boolean" },
                    "destructive": { "type": "boolean" },
                    "requiresConfirmation": { "type": "boolean" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "backups": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "path", "checksum", "createdAt", "verified"],
        "properties": {
          "id": { "type": "string" },
          "kind": {
            "type": "string",
            "enum": ["pre-install", "pre-upgrade", "pre-uninstall", "manual", "recovery"]
          },
          "path": { "type": "string" },
          "checksum": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "createdAt": { "type": "string", "format": "date-time" },
          "verified": { "type": "boolean" },
          "restorable": { "type": "boolean" },
          "notes": { "type": "string" }
        }
      }
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["operation", "state", "startedAt", "updatedAt"],
        "properties": {
          "operation": {
            "type": "string",
            "enum": ["install", "reinstall", "upgrade", "rollback", "uninstall", "diagnose", "repair", "restore"]
          },
          "state": {
            "type": "string",
            "enum": [
              "not-installed",
              "installation-detected",
              "installation-in-progress",
              "installation-completed",
              "installation-partially-completed",
              "installation-failed",
              "upgrade-available",
              "upgrade-in-progress",
              "rollback-available",
              "rollback-in-progress",
              "uninstallation-pending-confirmation",
              "uninstallation-in-progress",
              "uninstallation-partially-completed",
              "uninstallation-completed",
              "diagnostic-analysis-in-progress",
              "repair-available",
              "repair-in-progress",
              "recovery-required"
            ]
          },
          "startedAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" },
          "completedAt": { "type": "string", "format": "date-time" },
          "result": {
            "type": "string",
            "enum": ["success", "partial", "failure", "blocked", "dry-run"]
          },
          "message": { "type": "string" },
          "step": { "type": "string" }
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "summary"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["success", "partial", "failure", "blocked", "dry-run"]
        },
        "summary": {
          "type": "string"
        },
        "notes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "warnings": {
          "type": "array",
          "items": { "type": "string" }
        },
        "errors": {
          "type": "array",
          "items": { "type": "string" }
        },
        "nextSteps": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "manualActions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "notes": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
